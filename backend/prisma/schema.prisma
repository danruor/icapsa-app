generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(MEMBER)
  isActive  Boolean  @default(true)
  phone     String?
  position  String?
  company   String?  // empresa del cliente (rol CLIENT)
  visibleTabs String @default("projects,inventory,calendar,chat,board,support,field")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects      ProjectMember[]
  tasksCreated  Task[]          @relation("TaskCreator")
  tasksAssigned Task[]          @relation("TaskAssignee")
  files         File[]
  comments      Comment[]
  movements     InventoryMovement[]
  notifications Notification[]
  pushTokens    PushToken[]
  notes         Note[]
  activities    Activity[]
  quotes        Quote[]
  purchaseOrders PurchaseOrder[]
  deliveries    Delivery[]
  chatParticipations ConversationParticipant[]
  chatMessages  ChatMessage[]
  conversationsCreated Conversation[] @relation("ConvCreator")
  boardCardsCreated  BoardCard[] @relation("CardCreator")
  boardCardsAssigned BoardCard[] @relation("CardAssignee")
  partnerDeals    PartnerDeal[]
  partnerPayments PartnerPayment[]
  partnerDataCharges PartnerDataCharge[]
  partnerConcepts PartnerConcept[]
  partnerCompetitorPrices PartnerCompetitorPrice[]
  ticketsCreated    SupportTicket[]    @relation("TicketCreator")
  ticketsAssigned   SupportTicket[]    @relation("TicketAssignee")
  ticketMessages    TicketMessage[]
  ticketAttachments TicketAttachment[]
  ticketVisits      TicketVisit[]      @relation("VisitTechnician")
  fieldAssignments  FieldAssignment[]
  fieldReports      FieldReport[]      @relation("ReportAuthor")
  fieldReportsReviewed FieldReport[]   @relation("ReportReviewer")
  fieldPhotos       FieldPhoto[]
  fieldLogs         FieldLog[]
  fieldAttendanceAuthored FieldAttendance[] @relation("AttendanceAuthor")
  fieldAttendanceAs       FieldAttendance[] @relation("AttendanceWorker")
  fieldEvents       FieldEvent[]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  MEMBER
  CLIENT // usuario externo: solo portal de soporte
  INSTALLER // instalador de campo: solo portal de obra (reportes diarios)
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  color       String        @default("#2196F3")
  startDate   DateTime?
  endDate     DateTime?
  address     String?
  latitude    Float?
  longitude   Float?
  budget      Float?
  client      String?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members    ProjectMember[]
  tasks      Task[]
  files      File[]
  inventory  InventoryItem[]
  activities Activity[]
  quotes     Quote[]
  purchaseOrders PurchaseOrder[]
  deliveries Delivery[]
  boardCards BoardCard[]
  notes       Note[]  @relation("NoteProjects")
  partnerDeals PartnerDeal[]
  supportTickets SupportTicket[]
  fieldSites     FieldSite[]
  fieldAssignments FieldAssignment[]
  fieldReports   FieldReport[]
  fieldLogs      FieldLog[]
  fieldAttendance FieldAttendance[]
  fieldEvents    FieldEvent[]
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model ProjectMember {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      Role     @default(MEMBER)
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  projectId  String
  creatorId  String
  assigneeId String?

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator  User      @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  comments Comment[]
  files    File[]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model File {
  id        String   @id @default(cuid())
  name      String
  url       String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())

  uploadedById String
  projectId    String?
  taskId       String?

  uploadedBy User     @relation(fields: [uploadedById], references: [id])
  project    Project? @relation(fields: [projectId], references: [id])
  task       Task?    @relation(fields: [taskId], references: [id])
}

model InventoryItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  sku         String?
  quantity    Int      @default(0)
  unit        String   @default("pza")
  minStock    Int      @default(0)
  location    String?
  category    String?
  unitPrice   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  movements InventoryMovement[]
}

model InventoryMovement {
  id        String   @id @default(cuid())
  type      MovementType
  quantity  Int
  unitPrice Float?
  note      String?
  createdAt DateTime @default(now())

  itemId String
  userId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id])

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  deliveryId      String?
  delivery        Delivery?      @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
}

enum MovementType {
  IN
  OUT
  ADJUST
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // task_assigned, task_due, comment, project_added, etc.
  title     String
  message   String
  link      String?  // ruta interna ej: /projects/xxx
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Activity {
  id        String   @id @default(cuid())
  action    String   // created_task, updated_status, added_inventory, etc.
  detail    String   // descripción legible
  createdAt DateTime @default(now())

  userId    String
  projectId String?
  user      User     @relation(fields: [userId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  sku         String?
  category    String?
  unit        String   @default("pza")
  price       Float    @default(0)
  cost        Float?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quoteItems QuoteItem[]
}

model Quote {
  id          String      @id @default(cuid())
  folio       String      @unique
  clientName  String
  clientEmail String?
  clientPhone String?
  status      QuoteStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(PENDING)
  paidAmount  Float       @default(0)
  paidAt      DateTime?
  deletedAt   DateTime?
  notes       String?
  taxRate     Float       @default(16)
  validUntil  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  items       QuoteItem[]

  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  deliveries  Delivery[]
  boardCards  BoardCard[]
  linkedNotes Note[]  @relation("NoteQuotes")
  supportTickets SupportTicket[]
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

model QuoteItem {
  id        String  @id @default(cuid())
  quantity  Int     @default(1)
  unitPrice Float
  discount  Float   @default(0)

  quoteId   String
  productId String?
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])

  // snapshot del producto al momento de cotizar
  name      String
  unit      String  @default("pza")
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  folio       String   @unique
  supplier    String
  status      String   @default("RECEIVED")
  notes       String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  movements   InventoryMovement[]
  boardCards  BoardCard[]
  supportTickets SupportTicket[]
}

model Delivery {
  id          String   @id @default(cuid())
  folio       String   @unique
  recipient   String
  status      String   @default("DELIVERED")
  signature   String?
  notes       String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quoteId     String?
  quote       Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  movements   InventoryMovement[]
  supportTickets SupportTicket[]
}

model Conversation {
  id          String   @id @default(cuid())
  type        String   @default("DIRECT") // DIRECT | GROUP
  name        String?  // solo grupos
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) // ultima actividad (se toca con cada mensaje)

  createdById String?
  createdBy   User?    @relation("ConvCreator", fields: [createdById], references: [id], onDelete: SetNull)

  participants ConversationParticipant[]
  messages     ChatMessage[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  isAdmin        Boolean  @default(false) // administrador del grupo
  hidden         Boolean  @default(false) // chat "eliminado" de mi lista (reaparece con mensajes nuevos)
  clearedAt      DateTime? // corte de historial: solo veo mensajes posteriores
  lastReadAt     DateTime @default(now())
  joinedAt       DateTime @default(now())

  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model ChatMessage {
  id             String    @id @default(cuid())
  content        String
  type           String    @default("TEXT") // TEXT | SYSTEM
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  conversationId String
  senderId       String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

model BoardColumn {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#94A3B8")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  cards BoardCard[]
}

model BoardCard {
  id          String    @id @default(cuid())
  title       String
  description String?
  priority    String?   // LOW | MEDIUM | HIGH
  position    Int       @default(0)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  columnId String
  column   BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User    @relation("CardCreator", fields: [createdById], references: [id])
  assigneeId  String?
  assignee    User?   @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quoteId         String?
  quote           Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([columnId, position])
}

// Tokens de notificaciones push (Expo) por dispositivo
model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  platform  String   @default("ios")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Notas personales privadas (texto + dibujo de Apple Pencil como trazos vectoriales)
model Note {
  id        String   @id @default(cuid())
  title     String
  content   String?
  drawing   String?  // JSON de trazos {color,width,d} para render como SVG
  color     String   @default("#FDE68A")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projects Project[] @relation("NoteProjects")
  quotes   Quote[]   @relation("NoteQuotes")

  @@index([userId, updatedAt])
}

// ===== SOCIEDAD (finanzas ICAPSA·DELEVSIS — acceso ultra restringido) =====

model PartnerSettings {
  id                 String @id @default("main")
  partnerName        String @default("DELEVSIS")
  defaultFx          Float  @default(19)    // tipo de cambio USD→MXN
  defaultIsr         Float  @default(30)    // % ISR
  defaultPartnerRate Float  @default(35)    // % del socio sobre utilidad neta
  defaultIva         Float  @default(16)
  // Tarifas de datos (SIM)
  dataCostPerMB       Float  @default(0) // lo que cobra el proveedor por MB
  dataSalePerMB       Float  @default(0) // lo que cobramos al cliente por MB
  dataFixedCostPerSim Float  @default(0) // cargo fijo mensual por SIM (proveedor)
  dataFixedSalePerSim Float  @default(0) // cargo fijo mensual por SIM (cliente)
  // Ejercicios cerrados (CSV de años) — bloquean modificaciones
  closedYears        String @default("")
}

model PartnerDeal {
  id           String   @id @default(cuid())
  name         String   // nombre del contrato u obra: "Torre Lítica"
  area         String?  // legacy (se conserva por compatibilidad)
  clientType   String   @default("PRIVATE") // CFE | PRIVATE
  clientName   String?  // constructora/cliente (privados) — CFE se autollenа
  division     String?  // división de distribución CFE (si aplica)
  state        String?  // estado de la República (privados)
  contractRef  String?  // No. de contrato o pedido
  includesData Boolean  @default(false) // tarjetas con datos (SIM)
  dataNotes    String?  // plan, MB/mes, tarifa de datos...
  dealDate     DateTime @default(now()) // fecha del contrato (análisis temporal)
  quantity     Int      @default(1)
  costUnit     Float    @default(0)
  costCurrency String   @default("USD")  // USD | MXN
  saleUnit     Float    @default(0)
  saleCurrency String   @default("USD")
  fx           Float    @default(19)
  isrRate      Float    @default(30)
  partnerRate  Float    @default(35)
  ivaRate      Float    @default(16)
  status       String   @default("OPEN") // OPEN | CLOSED
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  items       PartnerDealItem[]
  dataCharges PartnerDataCharge[]
}

model PartnerPayment {
  id        String   @id @default(cuid())
  direction String   // TO_PARTNER (ICAPSA→socio) | FROM_PARTNER (socio→ICAPSA)
  amount    Float    // MXN
  concept   String
  method    String?  // transferencia, efectivo...
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  createdById String
  createdBy   User @relation(fields: [createdById], references: [id])
}

model PartnerDealItem {
  id           String @id @default(cuid())
  name         String // "Trifásicas 79", "Medidor con interna"
  quantity     Int    @default(1)
  costUnit     Float  @default(0)
  costCurrency String @default("USD")
  saleUnit     Float  @default(0)
  saleCurrency String @default("USD")
  position     Int    @default(0)

  dealId String
  deal   PartnerDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  conceptId String?
  concept   PartnerConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)
}

model PartnerDataCharge {
  id               String   @id @default(cuid())
  period           String   // YYYY-MM
  concept          String   // "Consumo datos julio", plan, etc.
  cardsCount       Int?
  amountToPartner  Float    // adeudo del mes al proveedor (DELEVSIS)
  amountFromClient Float?   // lo cobrado al cliente por datos
  notes            String?
  // Consumo variable por SIM/lote
  simLabel         String?  // ICCID, etiqueta o lote
  mbUsed           Float?   // MB consumidos en el periodo
  costPerMB        Float?   // tarifas aplicadas (snapshot del momento)
  salePerMB        Float?
  fixedCostPerSim  Float?
  fixedSalePerSim  Float?
  autoCalc         Boolean  @default(false) // montos calculados desde MB
  createdAt        DateTime @default(now())

  createdById String
  createdBy   User @relation(fields: [createdById], references: [id])
  dealId      String?
  deal        PartnerDeal? @relation(fields: [dealId], references: [id], onDelete: SetNull)
}

// Catálogo maestro de conceptos (tarjetas/productos) con costeo configurable
model PartnerConcept {
  id           String   @id @default(cuid())
  name         String
  description  String?
  costingMode  String   @default("TOTAL") // TOTAL | BREAKDOWN (desglosado)
  costUnit     Float    @default(0)       // costo total (si TOTAL) o suma cacheada
  costCurrency String   @default("USD")
  saleUnit     Float    @default(0)       // precio de venta de referencia
  saleCurrency String   @default("USD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdById String
  createdBy   User @relation(fields: [createdById], references: [id])

  costParts        PartnerConceptCost[]
  dealItems        PartnerDealItem[]
  competitorPrices PartnerCompetitorPrice[]
  prices           PartnerConceptPrice[]
}

// Precio de venta del concepto según división CFE, estado o cliente
model PartnerConceptPrice {
  id           String   @id @default(cuid())
  scopeType    String   // CFE_DIVISION | STATE | CLIENT
  scope        String   // "Jalisco", "Valle de México Centro", "Francisco"...
  saleUnit     Float
  saleCurrency String   @default("USD")
  notes        String?
  createdAt    DateTime @default(now())

  conceptId String
  concept   PartnerConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
}

// Partes del costo interno (manufactura, componentes, software...)
model PartnerConceptCost {
  id       String @id @default(cuid())
  label    String // "Manufactura", "Componentes", "Software"...
  amount   Float  @default(0)
  currency String @default("USD")
  position Int    @default(0)

  conceptId String
  concept   PartnerConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
}

// Precios de la competencia (licitaciones, constructoras) para análisis
model PartnerCompetitorPrice {
  id         String   @id @default(cuid())
  competitor String   // empresa competidora
  price      Float
  currency   String   @default("MXN")
  priceType  String   @default("SALE") // SALE | COST (estimado)
  context    String?  // licitación, constructora, división...
  date       DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())

  conceptId String?
  concept   PartnerConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User @relation(fields: [createdById], references: [id])
}

// ===== SOPORTE A CLIENTES (tickets con trazabilidad completa) =====

model SupportTicket {
  id              String    @id @default(cuid())
  folio           String    @unique // TKT-AAAA-NNNN
  title           String
  description     String
  category        String    @default("OTHER")  // FAILURE | INSTALLATION | DATA | BILLING | WARRANTY | OTHER
  priority        String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status          String    @default("OPEN")   // OPEN | IN_PROGRESS | WAITING_CLIENT | RESOLVED | CLOSED
  company         String?   // empresa del cliente (snapshot para filtros)
  location        String?   // sitio / obra / dirección
  equipment       String?   // equipo, serie o medidor afectado
  slaDueAt        DateTime? // límite de atención según prioridad
  slaNotifiedAt   DateTime? // aviso de SLA vencido ya enviado
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  rating          Int?      // 1-5 calificación del cliente al cerrar
  ratingComment   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdById String
  createdBy   User   @relation("TicketCreator", fields: [createdById], references: [id])
  assigneeId  String?
  assignee    User?  @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  projectId       String?
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quoteId         String?
  quote           Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  deliveryId      String?
  delivery        Delivery?      @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  messages    TicketMessage[]
  attachments TicketAttachment[]
  visits      TicketVisit[]

  @@index([status, priority])
  @@index([createdById])
  @@index([assigneeId])
}

model TicketMessage {
  id        String   @id @default(cuid())
  kind      String   @default("MESSAGE") // MESSAGE (visible al cliente) | INTERNAL (solo equipo) | SYSTEM (evento)
  body      String
  createdAt DateTime @default(now())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  attachments TicketAttachment[]

  @@index([ticketId, createdAt])
}

model TicketAttachment {
  id        String   @id @default(cuid())
  name      String
  url       String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())

  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messageId String?
  message   TicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploadedById String
  uploadedBy   User @relation(fields: [uploadedById], references: [id])
}

model TicketVisit {
  id          String   @id @default(cuid())
  scheduledAt DateTime
  durationMin Int      @default(120)
  status      String   @default("SCHEDULED") // SCHEDULED | DONE | CANCELLED
  notes       String?  // indicaciones previas
  outcome     String?  // resultado de la visita
  createdAt   DateTime @default(now())

  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  technicianId String?
  technician   User? @relation("VisitTechnician", fields: [technicianId], references: [id], onDelete: SetNull)

  @@index([scheduledAt])
}

// ===== INSTALACIÓN EN CAMPO (sellado de bóvedas con ROXTEC) =====

// Catálogo de material de campo (marcos GKO, sellos RS, módulos, impermeabilizante...)
model FieldMaterial {
  id        String   @id @default(cuid())
  sku       String?  @unique
  name      String   // "Marco GKO 4", "Sello RS 75", "Módulo CM 20 w40"
  category  String   @default("OTHER") // FRAME | SEAL | MODULE | COATING | ACCESSORY | CONSUMABLE | OTHER
  unit      String   @default("pza")
  unitCost  Float    @default(0)      // costo unitario de referencia (MXN)
  currency  String   @default("MXN")
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages      FieldMaterialUsage[]
  allocations FieldAllocation[]
}

// Bóveda / subestación / registro dentro de una obra
model FieldSite {
  id             String   @id @default(cuid())
  code           String   // "Bóveda 7", "SE-03"
  name           String?  // "Seminario No. 181 y Moneda"
  address        String?
  siteType       String   @default("VAULT") // VAULT | SUBSTATION | MANHOLE | OTHER
  equipment      String?  // seccionador, derivador, transformador, gabinete...
  infiltration   String?  // CSV: RAIN,POTABLE,SEWAGE
  stage          String   @default("PENDING") // PENDING | DEWATERING | WALL_PREP | FORMWORK | SEALING | COATING | DONE
  status         String   @default("PENDING") // PENDING | IN_PROGRESS | DONE
  latitude       Float?
  longitude      Float?
  notes          String?
  position       Int      @default(0)
  // Programa de obra: planeado vs real
  plannedStart   DateTime?
  plannedEnd     DateTime?
  plannedDays    Int?
  actualStart    DateTime? // primer día con bitácora/reporte
  actualEnd      DateTime? // fecha en que se marcó terminada
  createdById    String?   // instalador u oficina que la dio de alta
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  openings FieldOpening[]
  reports  FieldReport[]
  photos   FieldPhoto[]
  logs     FieldLog[]
  attendance FieldAttendance[]
  events   FieldEvent[]

  @@index([projectId, position])
}

// Ventana pasamuros / punto de sellado dentro de una bóveda
model FieldOpening {
  id          String   @id @default(cuid())
  label       String   // "Ventana pasamuros norte", "Ducto 3"
  description String?  // tamaño, cables que cruzan...
  status      String   @default("PENDING") // PENDING | SEALED
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  siteId String
  site   FieldSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  usages FieldMaterialUsage[]
  photos FieldPhoto[]
}

// Instalador asignado a una obra (define qué ve en su portal)
model FieldAssignment {
  id        String   @id @default(cuid())
  isLead    Boolean  @default(false) // responsable de cuadrilla
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

// Material asignado/entregado a una obra (presupuesto de consumo)
model FieldAllocation {
  id        String   @id @default(cuid())
  quantity  Float
  note      String?
  createdAt DateTime @default(now())

  projectId  String
  materialId String
  material   FieldMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Reporte diario del instalador por bóveda
model FieldReport {
  id          String    @id @default(cuid())
  folio       String    @unique // RPT-AAAA-NNNN
  reportDate  DateTime  @default(now())
  stage       String    @default("SEALING") // etapa trabajada ese día
  summary     String    // qué se hizo
  issues      String?   // problemas / bloqueos
  hoursWorked Float?
  crewSize    Int?
  status      String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId    String
  site      FieldSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation("ReportAuthor", fields: [authorId], references: [id])
  reviewerId String?
  reviewer   User?    @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  usages FieldMaterialUsage[]
  photos FieldPhoto[]

  @@index([projectId, reportDate])
  @@index([authorId])
}

// Material consumido (línea de un reporte; opcionalmente por ventana)
model FieldMaterialUsage {
  id        String   @id @default(cuid())
  quantity  Float
  unitCost  Float    // snapshot del costo al momento del reporte
  note      String?
  createdAt DateTime @default(now())

  reportId   String
  report     FieldReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  materialId String
  material   FieldMaterial @relation(fields: [materialId], references: [id])
  openingId  String?
  opening    FieldOpening? @relation(fields: [openingId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([materialId])
}

// Foto de evidencia (antes / durante / después)
model FieldPhoto {
  id        String   @id @default(cuid())
  url       String
  kind      String   @default("DURING") // BEFORE | DURING | AFTER
  caption   String?
  size      Int
  mimeType  String
  latitude  Float?
  longitude Float?
  takenAt   DateTime @default(now())
  createdAt DateTime @default(now())

  siteId     String
  site       FieldSite     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reportId   String?
  report     FieldReport?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  openingId  String?
  opening    FieldOpening? @relation(fields: [openingId], references: [id], onDelete: SetNull)
  uploadedById String
  uploadedBy   User @relation(fields: [uploadedById], references: [id])

  @@index([siteId])
}

// Bitácora diaria de obra (libre, sin material): avance, problemas, por qué no se termina
model FieldLog {
  id        String   @id @default(cuid())
  logDate   DateTime @default(now())
  kind      String   @default("NOTE") // NOTE | PROGRESS | ISSUE | DELAY | SAFETY | CLIENT
  body      String
  blocking  Boolean  @default(false) // ¿detiene el avance?
  resolvedAt DateTime?
  createdAt DateTime @default(now())

  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId    String?
  site      FieldSite? @relation(fields: [siteId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])

  @@index([projectId, logDate])
  @@index([siteId])
}

// Asistencia diaria: quién trabajó, en qué bóveda, cuántas horas
model FieldAttendance {
  id         String   @id @default(cuid())
  workDate   DateTime
  workerName String   // nombre libre (cuadrilla puede incluir gente sin usuario)
  hours      Float?
  role       String?  // instalador, ayudante, oficial...
  note       String?
  createdAt  DateTime @default(now())

  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId    String?
  site      FieldSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  workerId  String?    // si la persona tiene usuario
  worker    User?      @relation("AttendanceWorker", fields: [workerId], references: [id], onDelete: SetNull)
  authorId  String
  author    User       @relation("AttendanceAuthor", fields: [authorId], references: [id])

  @@index([projectId, workDate])
  @@index([siteId, workDate])
}

// Historial inmutable de cambios en una bóveda (trazabilidad)
model FieldEvent {
  id        String   @id @default(cuid())
  action    String   // SITE_CREATED | STAGE | SCHEDULE | REPORT_SUBMITTED | REPORT_REVIEWED | LOG | ATTENDANCE | OPENING | PHOTO
  detail    String
  createdAt DateTime @default(now())

  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId    String?
  site      FieldSite? @relation(fields: [siteId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])

  @@index([siteId, createdAt])
  @@index([projectId, createdAt])
}
